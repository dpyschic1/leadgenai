{
  "name": "leadgenai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed:demo": "tsx --conditions=react-server --env-file=.env scripts/seed-demo.ts",
    "osm:import": "tsx --conditions=react-server --env-file-if-exists=.env scripts/import-osm.ts",
    "overture": "tsx --conditions=react-server --env-file-if-exists=.env scripts/overture.ts",
    "yc": "tsx --conditions=react-server --env-file-if-exists=.env scripts/yc.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.72",
    "@hookform/resolvers": "^6.0.2",
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-query": "^5.105.0",
    "ai": "^7.0.156",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}

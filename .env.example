# Local PostgreSQL 17. Use the port you chose when installing it (the installer's default is 5432).
DATABASE_URL=postgres://leadgenai:leadgenai@localhost:5432/leadgenai

# AI analysis (free tier: https://console.groq.com/keys)
GROQ_API_KEY=
# Optional; defaults to openai/gpt-oss-120b. Must support Groq structured outputs.
GROQ_MODEL=

# TheirStack job posts (https://app.theirstack.com, Settings > API key). Free plan: 200 API credits a month.
THEIRSTACK_API_KEY=
# Jobs fetched per daily run (1 credit each). Default 6.
THEIRSTACK_JOBS_PER_DAY=6
